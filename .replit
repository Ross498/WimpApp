modules = ["nodejs-20", "web", "postgresql-16", "flutter"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["curl", "git", "unzip", "flutter", "chromium", "jq"]

[env]
REPLIT_DISABLE_PACKAGE_LAYER = "1"
REPLIT_KEEP_PACKAGE_DEV_DEPENDENCIES = "1"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd client && npm run build"]
run = ["sh", "-c", "NODE_ENV=production tsx server/index.ts"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 36219
externalPort = 3000

[[ports]]
localPort = 37057
externalPort = 4200

[[ports]]
localPort = 37261
externalPort = 3001

[[ports]]
localPort = 41261
externalPort = 5000

[[ports]]
localPort = 41269
externalPort = 5173

[[ports]]
localPort = 41493
externalPort = 3003

[[ports]]
localPort = 44011
externalPort = 3002

[workflows]
runButton = "Dev Server"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Flutter Dev"
author = 42589811
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd flutter_app && flutter run -d web-server --web-hostname=0.0.0.0 --web-port=5000"

[[workflows.workflow]]
name = "Flutter Web"
author = 42589811
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "export PATH=\"$PATH:`pwd`/flutter/bin\" && cd flutter_app && flutter run -d web-server --web-hostname=0.0.0.0 --web-port=5000"

[[workflows.workflow]]
name = "React Native"
author = 42589811
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd mr-butler && npm install && npx expo start --web --port 5000 --host 0.0.0.0"

[[workflows.workflow]]
name = "React Native Main"
author = 42589811
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd react-native-app && npm install && npx expo start --web --port 5000 --host 0.0.0.0"

[[workflows.workflow]]
name = "Dev Server"
author = 42589811
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_ENV=development tsx server/index.ts"

[agent]

[objectStorage]
defaultBucketID = "replit-objstore-4d5b0371-e9cb-428c-a83d-0b86a7dd7594"
